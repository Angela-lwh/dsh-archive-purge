# Third-party extracts of the shipped DSH packages, produced on demand by tools/asar.mjs.
# They are ~960 files of someone else's code; regenerate them locally instead of vendoring.
vendor/

# Install / debug scratch
node_modules/
*.log
cordis.patch.yml.bak-*
tools/out-*.json

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# DSH per-project state. The memory plugin writes `.dsh/` next to the workspace on its
# own; this repository keeps no memory files and never commits them.
.dsh/
