{
  "name": "dsh-archive-purge",
  "version": "1.0.0",
  "private": false,
  "description": "Delete action for archived DeepSeek Harness sessions: permanently removes the session log, its Workspace membership, and its archive mark.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "archive",
    "delete"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "locale"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "node ../tools/test-host.mjs && node ../tools/test-client.mjs"
  },
  "author": "李文浩 (https://github.com/Angela-lwh)",
  "homepage": "https://github.com/Angela-lwh/dsh-archive-purge#readme",
  "bugs": {
    "url": "https://github.com/Angela-lwh/dsh-archive-purge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angela-lwh/dsh-archive-purge.git",
    "directory": "plugin"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
