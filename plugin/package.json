{
  "name": "@angela_lwh/dsh-archive-purge",
  "version": "1.0.3",
  "private": false,
  "description": "Delete action for archived DeepSeek Harness sessions: permanently removes the session log, its Workspace membership, and its archive mark.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "archive",
    "delete"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "locale"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "node ../tools/verify-package.mjs && node ../tools/test-host.mjs && node ../tools/test-client.mjs"
  },
  "author": "李文浩 (https://github.com/Angela-lwh)",
  "homepage": "https://github.com/Angela-lwh/dsh-archive-purge#readme",
  "bugs": {
    "url": "https://github.com/Angela-lwh/dsh-archive-purge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angela-lwh/dsh-archive-purge.git",
    "directory": "plugin"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:write",
      "storage:write",
      "ui:extend",
      "webserver:register"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.0-rc.1",
        "0.2.1-rc.1",
        "0.2.1-rc.2"
      ]
    },
    "capability": {
      "id": "archived-session-delete",
      "kind": "service",
      "invocation": "archive a throwaway Session, then call POST /api/archive-purge/deleteSession with its id and a browser-session cookie (the same route the row's \"...\" menu -> Delete session uses)",
      "expected": "the reply reports deleted:true for that id, its directory under $DSH_HOME/sessions is gone, and the id no longer appears in $DSH_HOME/storages/workspace.json archivedSessionIds"
    },
    "evidence": {
      "install": "README.md",
      "failureIsolation": null,
      "hotReload": "README.md",
      "remove": "README.md"
    }
  },
  "license": "MIT"
}
